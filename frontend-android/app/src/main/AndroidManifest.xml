<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- モデル・任意データのダウンロード（B 担当）。C の更新確認も同じ権限を使う -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 本体 APK の更新（PackageInstaller。C 担当） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Nagi">

        <!-- 本体アプリの入口（下部タブ: ホーム / 入力テスト / 設定 / レイアウト / About）。singleTask: 初回案内・nagi://layout から同じ画面へ戻す -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 本体アプリの設定系画面（B 担当）。画面回転で作り直さない（ダウンロード中の進捗を保つため） -->
        <!-- nagi://layout（ブラウザ等の外部アプリから）の受け口なので exported。画面は持たず、MainActivity のレイアウトタブへ渡す（取り込みは必ず確認ダイアログを挟む） -->
        <activity
            android:name=".LayoutManagerActivity"
            android:exported="true"
            android:label="キーボードのレイアウト"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="layout"
                    android:scheme="nagi" />
            </intent-filter>
        </activity>
        <!-- JSON の貼り付け取り込み。回転で作り直さない（入力内容を保つ） -->
        <activity
            android:name=".LayoutPasteActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="false"
            android:label="JSON を貼り付け"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".UserDictActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="false"
            android:label="ユーザー辞書"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ModelActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="false"
            android:label="変換モデル" />
        <activity
            android:name=".OptionalDataActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="false"
            android:label="英語・カタカナ語データ" />

        <!-- アップデート画面（C 担当）。画面回転で作り直さない（ダウンロード中断を避けるため） -->
        <activity
            android:name=".UpdateActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="false"
            android:label="アップデート" />

        <!-- 使い始めの手順・開発者・データの使用量（画面系の機能） -->
        <activity
            android:name=".OnboardingActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="false"
            android:label="使い始めの手順"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".DeveloperActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="false"
            android:label="開発者"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".DataUsageActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="false"
            android:label="データの使用量" />

        <service
            android:name=".NagiImeService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
